# Copy to terraform.tfvars (gitignored). Do not commit real secrets.
# Apply this stack only in the dedicated wager-bidder AWS account.
# Never use the vibuthar-academy account (649058762344) or its CLI profile.

aws_region  = "ap-south-1"
aws_profile = "wager-bidder"
# allowed_account_ids = ["123456789012"] # new wager-bidder account ID

project_name = "wager-bidder"
environment  = "prod"

# Initial admin created only when the database has no users.
admin_username = "admin"
admin_password = "replace-with-a-strong-password"
admin_name     = "House Admin"

create_rds = true

# Free Tier EC2 host. Bump to t3.small later if the API OOMs.
ecs_instance_type = "t3.micro"
ecs_cpu           = "512"
ecs_memory        = "512"

acm_certificate_arn = "arn:aws:acm:ap-south-1:701179922860:certificate/bfa8bee5-de80-48d8-8199-6f03a6d4210b"
api_hostname        = "api.wager-game.online"
alb_ssl_policy      = "ELBSecurityPolicy-TLS13-1-2-Res-PQ-2025-09"

# First deploy creates tables. Switch to validate after the schema is stable.
spring_jpa_hibernate_ddl_auto = "update"
